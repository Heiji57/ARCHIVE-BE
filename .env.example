# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Token lifecycle
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Email verification
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_VERIFY_CODE_TTL_SECONDS=600       # 인증 코드 유효 시간 (10분)
EMAIL_VERIFIED_TTL_SECONDS=1800         # 인증 완료 상태 유지 (30분)
EMAIL_COOLDOWN_TTL_SECONDS=60           # 재발송 대기
EMAIL_MAX_VERIFY_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────────────────────
# Auth — OAuth flows
# ─────────────────────────────────────────────────────────────────────────────
OAUTH_STATE_TTL_SECONDS=600             # OAuth state 1회용 토큰 만료 (10분)
ONBOARDING_TOKEN_TTL_SECONDS=1800       # OAuth 신규 사용자 온보딩 토큰 만료 (30분)

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Password reset
# ─────────────────────────────────────────────────────────────────────────────
PASSWORD_RESET_TTL_SECONDS=1800         # 재설정 토큰 만료 (30분)
PASSWORD_RESET_COOLDOWN_TTL_SECONDS=60  # 메일 재발송 쿨다운

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Session security (OAuth 2.1 rotation + reuse detection)
# ─────────────────────────────────────────────────────────────────────────────
# 동시 refresh race 흡수 윈도. 너무 짧으면 동시 탭에서 false positive 탈취 판정,
# 너무 길면 진짜 탈취 시 새 RT 정상 발급 후 공격자의 옛 RT 가 grace 안에 들어와 회피 가능.
# 보수적으로 3~10초 권장.
SESSION_GRACE_WINDOW_SECONDS=5.0

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=archive
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@postgres:5432/archive

# ─────────────────────────────────────────────────────────────────────────────
# Redis (Celery broker / result backend / 캐시 / auth 세션)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND_URL=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
REDIS_AUTH_URL=redis://redis:6379/3

# ─────────────────────────────────────────────────────────────────────────────
# OAuth providers
# REDIRECT_URI 는 FE proxy origin 으로 맞춘다 (예: dev = http://localhost:5173/api/v1/auth/oauth/{provider}/callback).
# 그래야 callback HTML 의 window.opener.postMessage 가 FE origin 으로 전달되어 origin 검증을 통과한다.
# 각 provider 콘솔(GitHub Settings / Google Cloud Console)의 Callback URL 도 동일해야 한다.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# Google Calendar 연동
# client_id/secret 은 위 GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET 를 공유한다.
# 캘린더는 로그인 OAuth 와 별개 흐름 — access_type=offline 으로 refresh_token 을
# 발급받아 저장해야 백그라운드 AI 요약(현지 1am)에서도 토큰 갱신이 가능하다.
# REDIRECT_URI 는 FE proxy origin 으로 맞추고(callback HTML postMessage),
# Google Cloud Console 의 승인된 리디렉션 URI + calendar.readonly scope 등록 필요.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/api/v1/calendar/callback
GOOGLE_CALENDAR_SCOPE=openid email https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_SYNC_STALENESS_SECONDS=120   # GET /todos 온디맨드 sync 임계 (2분, 앱 진입 시 즉시 반영 보조)
GOOGLE_CALENDAR_INITIAL_WINDOW_DAYS=400      # 초기 full sync 과거 윈도우 (~13개월, annual 커버)
GOOGLE_CALENDAR_FUTURE_WINDOW_DAYS=90        # 미래 이벤트 조회 윈도우 (다가오는 일정 표시)
GOOGLE_CALENDAR_STATE_TTL_SECONDS=600        # 캘린더 연결 OAuth state 1회용 토큰 만료 (10분)

# 백그라운드 주기 동기화 (Celery beat) — 수동 동기화 버튼 없이 서버가 최신 상태 유지.
# 비용 절감: 최근 CALENDAR_ACTIVE_DAYS 일 내 캘린더를 조회한 "활성 사용자"만 sync.
CALENDAR_SYNC_INTERVAL_MINUTES=5             # beat 발사 주기 (분)
CALENDAR_ACTIVE_DAYS=7                        # 이 일수 내 조회한 사용자만 백그라운드 sync
CALENDAR_SYNC_JITTER_SECONDS=240             # per-user sync 분산 폭 (정각 버스트 완화, < 300)

# ─────────────────────────────────────────────────────────────────────────────
# SMTP (이메일 발송)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ─────────────────────────────────────────────────────────────────────────────
# Google AI
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# Worker (Celery)
# ─────────────────────────────────────────────────────────────────────────────
# 사용자별 결정적 지터 폭. 매시간 정각 dispatcher 가 사용자들의 자동 요약을
# 0 ~ N 초 사이로 분산시켜 동시 부하를 완화한다. 0 이면 지터 비활성화.
SUMMARY_JITTER_SECONDS=1800
